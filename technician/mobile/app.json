{
  "expo": {
    "name": "Customer Service Partner",
    "slug": "twentyfourseven-technician",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "twentyfourseven-partner",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f5f8",
    "ios": {
      "bundleIdentifier": "com.twentyfourseven.partner",
      "supportsTablet": false
    },
    "android": {
      "package": "com.twentyfourseven.partner",
      "adaptiveIcon": {
        "backgroundColor": "#0f1d57",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1d57",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach before and after photos of the appliance to the job.",
          "cameraPermission": "Take before and after photos of the appliance for the job record."
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
